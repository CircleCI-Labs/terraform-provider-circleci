# circleci Provider

Manage CircleCI as code: organizations and projects, pipeline definitions and the
triggers that run them, contexts and secrets, groups and access, self-hosted
runners, orbs, config policies and organization settings.

For a large organization the payoff is onboarding — a new team's project, its
pipeline definition, its triggers and its context restrictions become a module
you apply, rather than a checklist somebody works through in the UI.

## Example Usage

A complete, working setup: a project, the pipeline definition that tells CircleCI
where to find its configuration, a trigger so it actually runs, and a context
holding a secret the jobs can use.

```terraform
terraform {
  required_providers {
    circleci = {
      source  = "CircleCI-Public/circleci"
      version = "~> 0.5"
    }
  }
}

# The token is best supplied with the CIRCLE_TOKEN environment variable.
provider "circleci" {}

data "circleci_organization" "example" {
  slug = "circleci/AaBbCcDdEeFfGg"
}

# GitHub App projects are addressed by a numeric VCS repository id, not by name.
# This resolves one from owner/repo so you never paste a magic number.
data "circleci_github_app_repository" "example" {
  org_id    = data.circleci_organization.example.id
  full_name = "example-org/example-repo"
}

resource "circleci_project" "example" {
  name   = "example-repo"
  org_id = data.circleci_organization.example.id
}

# A pipeline *definition* says where to check out and where the config lives.
# It is not an execution — see the "CircleCI object model" guide.
resource "circleci_pipeline_definition" "build" {
  project_id  = circleci_project.example.id
  name        = "build"
  description = "Build and test on every push"

  config_source_provider         = "github_app"
  config_source_file_path        = ".circleci/config.yml"
  config_source_repo_external_id = data.circleci_github_app_repository.example.external_id

  checkout_source_provider         = "github_app"
  checkout_source_repo_external_id = data.circleci_github_app_repository.example.external_id
}

# Without a trigger, a definition never runs.
resource "circleci_trigger" "on_push" {
  project_id             = circleci_project.example.id
  pipeline_definition_id = circleci_pipeline_definition.build.id

  event_source_provider         = "github_app"
  event_source_repo_external_id = data.circleci_github_app_repository.example.external_id
  event_preset                  = "all-pushes"
}

resource "circleci_context" "build" {
  name   = "build-secrets"
  org_id = data.circleci_organization.example.id
}

# value_wo is a write-only argument: it is never written to Terraform state.
# Bump value_wo_version to rotate the secret. Plain `value` also works and is
# stored in state; see the "Managing secrets" guide for the trade-off.
resource "circleci_context_environment_variable" "registry_token" {
  context_id       = circleci_context.build.id
  name             = "REGISTRY_TOKEN"
  value_wo         = var.registry_token
  value_wo_version = 1
}

# Restrict the context so only this project can use it.
resource "circleci_context_restriction" "build" {
  context_id = circleci_context.build.id
  type       = "project"
  value      = circleci_project.example.id
}
```

